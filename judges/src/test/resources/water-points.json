{
  "about": "Water points for the snap probe. Each point is derived from the shape of one water area, not placed by eye. Each point records the Overpass query that proves it lies inside that water area, and that query's answer.",
  "derivation": {
    "rule": "The water area is the union of the OpenStreetMap water relations listed for the city, cut to the map extract's boundary. Every highway, railway, bridge, pier, breakwater, groyne and ferry way that Overpass returns inside that area counts as an obstacle. The point is the centre of the largest circle that fits inside the water and touches no bank, no obstacle and no extract edge. Shapely's polylabel finds that centre to within 0.5 m, on a local flat projection in metres.",
    "water_relations": {
      "paris": {
        "relations": [
          2191006,
          3238606,
          10837211
        ],
        "why": "The three relations named La Seine that touch the City of Paris, listed by one Overpass query over the City of Paris area (area 3600007444)."
      },
      "new-york": {
        "relations": [
          2389632
        ],
        "why": "Upper New York Bay, the bay inside New York City's area (area 3600175905) that holds the lead point 40.6900, -74.0350."
      }
    },
    "obstacle_query": {
      "paris": [
        "[out:json][timeout:180];",
        "rel(id:2191006,3238606,10837211)->.w;",
        ".w out geom;",
        ".w map_to_area->.a;",
        "(way[highway](area.a); way[railway](area.a); way[man_made~\"^(pier|bridge|breakwater|groyne)$\"](area.a); way[bridge](area.a););",
        "out geom;"
      ],
      "new-york": [
        "[out:json][timeout:180];",
        "rel(id:2389632)->.w;",
        ".w out geom;",
        ".w map_to_area->.a;",
        "(way[highway](area.a); way[railway](area.a); way[man_made~\"^(pier|bridge|breakwater|groyne)$\"](area.a); way[bridge](area.a); way[route=ferry](area.a););",
        "out geom;"
      ]
    },
    "note": "Distances are to the water's edge, the coastline and the obstacle ways, not to the router's nearest path. The snap probe itself measures the router's snap distance."
  },
