{
  "about": "Land points for the tool probes. Every point is one row of the answer to the single Wikidata query recorded under \"query\". The query's own filter, ordering and limit decide which points are listed, and in which order.",
  "query": {
    "endpoint": "https://query.wikidata.org/sparql",
    "rule": "For each city: the three metro stations in use that lie nearest to the position Wikidata records for the city itself, nearest first. Ties break on the item address.",
    "sparql": [
      "SELECT ?city ?item ?itemLabel ?lat ?lon ?distanceKm WHERE {",
      "  {",
      "    SELECT ?city ?item ?coord ?distanceKm WHERE {",
      "      BIND(\"paris\" AS ?city)",
      "      wd:Q90 wdt:P625 ?centre .",
      "      SERVICE wikibase:around {",
      "        ?item wdt:P625 ?coord .",
      "        bd:serviceParam wikibase:center ?centre ;",
      "                        wikibase:radius \"1\" ;",
      "                        wikibase:distance ?distanceKm .",
      "      }",
      "      ?item wdt:P31 wd:Q928830 .",
      "      FILTER EXISTS { ?item wdt:P5817 wd:Q55654238 . }",
      "    }",
      "    ORDER BY ?distanceKm ?item",
      "    LIMIT 3",
      "  }",
      "  UNION",
      "  {",
      "    SELECT ?city ?item ?coord ?distanceKm WHERE {",
      "      BIND(\"new-york\" AS ?city)",
      "      wd:Q60 wdt:P625 ?centre .",
      "      SERVICE wikibase:around {",
      "        ?item wdt:P625 ?coord .",
      "        bd:serviceParam wikibase:center ?centre ;",
      "                        wikibase:radius \"1\" ;",
      "                        wikibase:distance ?distanceKm .",
      "      }",
      "      ?item wdt:P31 wd:Q928830 .",
      "      FILTER EXISTS { ?item wdt:P5817 wd:Q55654238 . }",
      "    }",
      "    ORDER BY ?distanceKm ?item",
      "    LIMIT 3",
      "  }",
      "  BIND(geof:latitude(?coord) AS ?lat)",
      "  BIND(geof:longitude(?coord) AS ?lon)",
      "  SERVICE wikibase:label { bd:serviceParam wikibase:language \"en\" . }",
      "}",
      "ORDER BY DESC(?city) ?distanceKm ?item"
    ],
