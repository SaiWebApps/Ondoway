{
  "worktree": {
    "baseRef": "head"
  },
  "advisorModel": "opus",
  "env": {
    "CLAUDE_CODE_ENABLE_EXPERIMENTAL_ADVISOR_TOOL": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'g=\"$CLAUDE_PROJECT_DIR/.claude/hooks/walk_receipts.py\"; [ -f \"$g\" ] || exit 0; exec python3 \"$g\"'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'g=\"$CLAUDE_PROJECT_DIR/.claude/hooks/walk_receipts.py\"; [ -f \"$g\" ] || exit 0; exec python3 \"$g\"'"
          }
        ]
      }
    ]
  }
}
