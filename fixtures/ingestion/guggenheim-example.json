  {
    "beat_id": "new_york/guggenheim-museum/the-spiral-and-the-ramp",
    "city_name": "new_york",
    "poi_name": "Guggenheim Museum",
    "story_slug": "the-spiral-and-the-ramp",
    "title": "The spiral and the ramp",
    "beat_type": "architectural_detail",
    "lenses": [
      "historic_arch",
      "modern_design"
    ],
    "sub_location": null,
    "trigger_address": "1071 Fifth Ave, New York, NY 10128",
    "claims": [
      {
        "claim_id": "c01",
        "text": "The inverted ziggurat form divided opinion from the start.",
        "kind": "belief",
        "status": "resolved",
        "sources": [
          {
            "source_id": "lonely-planet-new-york-city",
            "chunk": "chunk-07-upper-east-side",
            "span": "the inverted ziggurat structure was derided by some critics but hailed by others, who welcomed it as a beloved architectural icon.",
            "as_of": 2023,
            "rights_basis": "owned_copy",
            "stated_value": null
          }
        ],
        "resolved_value": null,
        "resolution": {
          "by": null,
          "decided_by": null,
          "decided_at": null
        },
        "verdict": {
          "judge_model": "claude-haiku-4-5",
          "entailed": true,
          "bound_to": "47f46500bc0a2fa892736546137265dc67e0e0c72a1fa88bfa916bbc259162e9"
        }
      },
      {
        "claim_id": "c02",
        "text": "The spiral sits among the conventional towers of Fifth Avenue.",
        "kind": "state",
        "status": "resolved",
        "sources": [
          {
            "source_id": "frommers-nyc-2024",
            "chunk": "chunk-05-ch05-uptown",
            "span": "delirious spiral of a museum sits among the towers of Fifth Avenue like a steroidal peacock among guinea hens.",
            "as_of": 2024,
            "rights_basis": "owned_copy",
            "stated_value": null
          }
        ],
        "resolved_value": null,
        "resolution": {
          "by": null,
          "decided_by": null,
          "decided_at": null
        },
        "verdict": {
          "judge_model": "claude-haiku-4-5",
          "entailed": true,
          "bound_to": "7d28cd97b35c9c021eaa98fec3c2e4eb8390f55decab5dddeb3e633d994f0ac0"
        }
      },
      {
        "claim_id": "c03",
        "text": "Wright meant visitors to start at the top and wind down, but the exhibitions are hung from the bottom up.",
        "kind": "state",
        "status": "resolved",
        "sources": [
          {
            "source_id": "lonely-planet-new-york-city",
            "chunk": "chunk-07-upper-east-side",
            "span": "Though Wright intended visitors to go to the top and wind their way down, the cramped single elevator makes this difficult. Exhibitions, therefore, are installed from bottom to top.",
            "as_of": 2023,
            "rights_basis": "owned_copy",
            "stated_value": null
          }
        ],
        "resolved_value": null,
        "resolution": {
          "by": null,
          "decided_by": null,
          "decided_at": null
        },
        "verdict": {
          "judge_model": "claude-haiku-4-5",
          "entailed": true,
          "bound_to": "cb78c48bcba13a5b0228c2ccdb3991578250e6183c35f98b13c5bd3409d30ccb"
        }
      }
    ],
    "narration": {
      "text": "A pile of stacked circles, widest at the sky, in a street of right angles. Some called it a spaceship and some called it a masterpiece, and both camps were loud about it. The architect wanted you to ride up and drift down; the single small elevator settled that differently, so the shows now begin on the ground.",
      "claims_hash": "e76ec2f5da038924863552dc95ea6abf9727e4d237db7a1ef2463a55cddc822d",
      "author_model": "claude-opus-5",
      "verdict": {
        "judge_model": "claude-haiku-4-5",
        "sentences_entailed": 3,
        "sentences_total": 3,
        "bound_to": "3e7951689c0dcb9f20a24ee9a50af22f5db0a07561118977c11d04d5a2565023"
      },
