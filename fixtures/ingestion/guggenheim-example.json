  {
    "beat_id": "new_york/guggenheim-museum/how-the-museum-came-to-be",
    "city_name": "new_york",
    "poi_name": "Guggenheim Museum",
    "story_slug": "how-the-museum-came-to-be",
    "title": "How the museum came to be",
    "beat_type": "anecdote",
    "lenses": [
      "hidden_history",
      "visual_art"
    ],
    "sub_location": null,
    "trigger_address": "1071 Fifth Ave, New York, NY 10128",
    "claims": [
      {
        "claim_id": "c01",
        "text": "Solomon R. Guggenheim began buying abstract art in his sixties, on the advice of Hilla Rebay.",
        "kind": "event",
        "status": "resolved",
        "sources": [
          {
            "source_id": "lonely-planet-new-york-city",
            "chunk": "chunk-07-upper-east-side",
            "span": "The Guggenheim came out of the collection of Solomon R Guggenheim, a New York mining magnate who began acquiring abstract art in his 60s at the behest of his art adviser, an eccentric German baroness named Hilla Rebay.",
            "as_of": 2023,
            "rights_basis": "owned_copy",
            "stated_value": null
          }
        ],
        "resolved_value": null,
        "resolution": {
          "by": null,
          "decided_by": null,
          "decided_at": null
        },
        "verdict": {
          "judge_model": "claude-haiku-4-5",
          "entailed": true,
          "bound_to": "acf9c3b76fa5ecd0de43431ec57e9c5befb3c47cdeafdb25f2c7f0c6c1b5eea1"
        }
      },
      {
        "claim_id": "c02",
        "text": "In 1939 the collection went on view in a temporary museum on 54th Street, called the Museum of Non-Objective Painting.",
        "kind": "event",
        "status": "resolved",
        "sources": [
          {
            "source_id": "lonely-planet-new-york-city",
            "chunk": "chunk-07-upper-east-side",
            "span": "In 1939, with Rebay serving as director, Guggenheim opened a temporary museum on 54th St titled the Museum of Non-Objective Painting.",
            "as_of": 2023,
            "rights_basis": "owned_copy",
            "stated_value": "1939"
          }
        ],
        "resolved_value": null,
        "resolution": {
          "by": null,
          "decided_by": null,
          "decided_at": null
        },
        "verdict": {
          "judge_model": "claude-haiku-4-5",
          "entailed": true,
          "bound_to": "9037e937342e9b26933b8a19023b6fec685cb328d8b7a8c20d9a63c7e6f2c015"
        }
      },
      {
        "claim_id": "c03",
        "text": "The building was finished in 1959, by which time both Wright and Guggenheim were dead.",
        "kind": "event",
        "status": "resolved",
        "sources": [
          {
            "source_id": "lonely-planet-new-york-city",
            "chunk": "chunk-07-upper-east-side",
            "span": "Construction was finally completed in 1959 – after both Wright and Guggenheim had passed away.",
            "as_of": 2023,
            "rights_basis": "owned_copy",
            "stated_value": "1959"
          },
          {
            "source_id": "frommers-nyc-2024",
            "chunk": "chunk-05-ch05-uptown",
            "span": "Visiting this 1959 masterpiece",
            "as_of": 2024,
            "rights_basis": "owned_copy",
            "stated_value": "1959"
          }
        ],
        "resolved_value": null,
        "resolution": {
          "by": "corroborated",
          "decided_by": null,
          "decided_at": null
        },
        "verdict": {
          "judge_model": "claude-haiku-4-5",
          "entailed": true,
          "bound_to": "9b08e6747c060ef716921b701e39a1e1caeac07e8c3cd99aaf38f04bae150f43"
        }
      }
    ],
    "narration": {
      "text": "An elderly mining millionaire started buying abstract paintings late in life, pushed along by an adviser named Hilla Rebay. Their first home for the pictures opened in 1939 on 54th Street, under the sober title Museum of Non-Objective Painting. The permanent building took two more decades, and neither man lived to walk into it.",
      "claims_hash": "0da7e0bc5d185ba46b7bb8c00622678957f8512825155b22546bbd95b301454c",
      "author_model": "claude-opus-5",
      "verdict": {
        "judge_model": "claude-haiku-4-5",
        "sentences_entailed": 3,
        "sentences_total": 3,
        "bound_to": "315b418ffdc7382b735e70ebeaff1560b2763881130d2ddb13717327625ea714"
      },
      "flags": []
    },
