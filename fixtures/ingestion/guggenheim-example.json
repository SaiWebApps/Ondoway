  {
    "beat_id": "new_york/guggenheim-museum/the-opening-and-the-critics",
    "city_name": "new_york",
    "poi_name": "Guggenheim Museum",
    "story_slug": "the-opening-and-the-critics",
    "title": "The opening and the critics",
    "beat_type": "event",
    "lenses": [
      "hidden_history"
    ],
    "sub_location": null,
    "trigger_address": "1071 Fifth Ave, New York, NY 10128",
    "claims": [
      {
        "claim_id": "c01",
        "text": "Admission cost fifty cents when the doors opened in October 1959.",
        "kind": "event",
        "status": "resolved",
        "sources": [
          {
            "source_id": "lonely-planet-new-york-city",
            "chunk": "chunk-07-upper-east-side",
            "span": "When the Guggenheim opened its doors in October 1959, the ticket price was 50¢",
            "as_of": 2023,
            "rights_basis": "owned_copy",
            "stated_value": "50 cents"
          }
        ],
        "resolved_value": null,
        "resolution": {
          "by": null,
          "decided_by": null,
          "decided_at": null
        },
        "verdict": {
          "judge_model": "claude-haiku-4-5",
          "entailed": true,
          "bound_to": "3f13fe5f44845d0d52ff682ced4602a324c3f4079203f63371c055b414b41372"
        }
      },
      {
        "claim_id": "c02",
        "text": "The New York Times attacked the new building, while other voices ranked it among the finest in the country.",
        "kind": "event",
        "status": "resolved",
        "sources": [
          {
            "source_id": "lonely-planet-new-york-city",
            "chunk": "chunk-07-upper-east-side",
            "span": "The structure was savaged by the New York Times, but others quickly celebrated it as one of the country’s most beautiful buildings.",
            "as_of": 2023,
            "rights_basis": "owned_copy",
            "stated_value": null
          }
        ],
        "resolved_value": null,
        "resolution": {
          "by": null,
          "decided_by": null,
          "decided_at": null
        },
        "verdict": {
          "judge_model": "claude-haiku-4-5",
          "entailed": true,
          "bound_to": "75a7ac7e91908472acefd96d6f96d5c6b5173e558b5375a3782d23cb2e2cba36"
        }
      },
      {
        "claim_id": "c03",
        "text": "Reviewers were dismissive of the museum in its first years.",
        "kind": "belief",
        "status": "resolved",
        "sources": [
          {
            "source_id": "frommers-nyc-2024",
            "chunk": "chunk-05-ch05-uptown",
            "span": "Early critics dismissed the museum",
            "as_of": 2024,
            "rights_basis": "owned_copy",
            "stated_value": null
          }
        ],
        "resolved_value": null,
        "resolution": {
          "by": null,
          "decided_by": null,
          "decided_at": null
        },
        "verdict": {
          "judge_model": "claude-haiku-4-5",
          "entailed": true,
          "bound_to": "536d55f0a550d550d67588d92f5273df781234b6c027632da9b358bbbe7b43fa"
        }
      }
    ],
    "narration": {
      "text": "Half a dollar bought you a ticket on the October morning in 1959 when the doors first opened. The reviews were brutal in places and rapturous in others, and the paper of record came down hard. Sixty years of visitors have quietly settled that argument.",
      "claims_hash": "7d8107feeee064376b599e6ac03dca1da03743734a01abb10ae884109c52bb02",
      "author_model": "claude-opus-5",
      "verdict": {
        "judge_model": "claude-haiku-4-5",
        "sentences_entailed": 3,
        "sentences_total": 3,
        "bound_to": "2907e6fe3b289047a9f9a66f96db5b02496b334a1697033a635f08d5050d37cf"
      },
      "flags": []
    },
